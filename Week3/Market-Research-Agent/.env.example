# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost:5432/competitor_research

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
# Generation models (structured output). Both default to the same model for now;
# OPENAI_MODEL can be upgraded independently later for the extraction/verification step.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- You.com Search API ---------------------------------------------------------
YOUCOM_API_KEY=
YOUCOM_BASE_URL=https://ydc-index.io

# --- Serper.dev (optional second, independent search provider) -----------------
# Explicit on/off switch, separate from just having a key set — lets you turn
# this off for cost control without deleting the key. Roughly doubles the
# search-cost portion of the pre-flight budget projection when enabled.
SERPER_ENABLED=false
SERPER_API_KEY=
SERPER_BASE_URL=https://google.serper.dev

# --- Pinecone Serverless --------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=competitor-research
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LangSmith (optional; app must run fine without it) ------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=market-research-agent

# --- Future AGI (optional second tracing/eval/simulation layer, runs alongside
# LangSmith, not instead of it) --------------------------------------------------
# Requires the optional `futureagi` uv dependency group: uv sync --group futureagi
FUTUREAGI_ENABLED=false
FI_API_KEY=
FI_SECRET_KEY=
FI_PROJECT_NAME=market-research-agent

# --- App -----------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_BUDGET_USD_LIMIT=5.00
COVERAGE_THRESHOLD=0.6
MAX_RETRIES_PER_COMPETITOR=2
MAX_GAP_RETRIES=3

# --- Tests (optional) ------------------------------------------------------------
# Point at any reachable Postgres to run the 2 migration/audit tests that need one.
# Leave unset to skip them (the other 23 tests always run against SQLite).
TEST_DATABASE_URL=
